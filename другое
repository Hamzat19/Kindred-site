from src.api.riot_client import watcher
from config import REGION, MY_PUUID
import json

# Получаем 1 матч
match_ids = watcher.match.matchlist_by_puuid(REGION, MY_PUUID, count=1)
match = watcher.match.by_id(REGION, match_ids[0])

# Сохраняем в файл, чтобы открыть в любом редакторе
with open('match_structure.json', 'w', encoding='utf-8') as f:
    json.dump(match, f, indent=2, ensure_ascii=False)

print("✅ Файл match_structure.json создан в папке проекта!")