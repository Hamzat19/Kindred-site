.gold-divider {
    width: 100%;
    background-color: rgb(10,20,40);
    padding: 20px 0;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    margin: 0;
}

/* ЛИНИЯ (через отдельный элемент, чтобы не мешать ромбикам) */
.gold-divider .gold-line {
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #c89b3c 20%, #c89b3c 80%, transparent);
}

/* ЛЕВЫЙ РОМБИК */
.gold-divider::before {
    content: '';
    position: absolute;
    left: 5%;
    width: 8px;
    height: 8px;
    border: 1px solid #c89b3c;
    transform: rotate(45deg);
    background-color: rgb(10,20,40);
}

/* ПРАВЫЙ РОМБИК */
.gold-divider::after {
    content: '';
    position: absolute;
    right: 5%;
    width: 8px;
    height: 8px;
    border: 1px solid #c89b3c;
    transform: rotate(45deg);
    background-color: rgb(10,20,40);
}



