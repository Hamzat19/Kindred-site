}

.blue-bg {

    background-color: rgb(10,20,40);
    position: relative;
    width: 100%;
    padding: 40px 20px;
    box-sizing: border-box;
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    flex-direction: row;
    z-index: 2;
    gap: 40px;
    min-height: auto; /* ← МЕНЯЕМ с 100vh на auto */
    padding-bottom: 200px;
}

.runes .blue-bg {
    min-height: auto !important;
}

.abilities-section {
    min-height: 100vh; /* ← ТОЛЬКО для умений */
    margin-top: 200px;
}

.ability-selector {
    display: flex;
    gap: 10px;
  
    margin-top: 50px;
    margin-left: 40px;
    justify-content: center;
    align-items: center;
    
}

.ability-right-col {
    display: flex;
    flex-direction: column;       /* Видео и описание в ряд (справа налево) */
    gap: 30px;
    flex: 1;                   /* Занимает всё оставшееся место справа */
    max-width: 1000px;         /* Ограничиваем ширину, чтобы не растягивалось бесконечно */
    align-self: flex-start;
    align-items: flex-start;   /* Чтобы левые края видео и текста совпадали */
    width: 100%;
}



.ability-btn {
    background: none;
    padding: 0;
    cursor: pointer;
    width: 80px;
    height: 80px;
    border-radius: 12px;
    transition: all 0.3s ease;
    border: 2px solid transparent;
}

.ability-btn img {
    width: 100%;
    height: 100%;
    border-radius: 8px;
}

img.runes-img { 
    width: 75%;
    height: 75%;
    border: 1px solid #c89b3c;
    border-radius: 8px;
    margin-top: 100px;
}

img.items-img { 
    width: 65%;
    height: 65%;
    border-radius: 8px;
    margin-top: 100px;
    border: 1px solid #c89b3c;
}

.ability-btn.active {
    border-color: #c89b3c;
    transform: scale(1.1);
    box-shadow: 0 0 15px rgba(200, 155, 60, 0.4);
}

