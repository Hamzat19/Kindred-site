.ability-video {
    flex: 1;
    max-width: 700px;
    padding: 26px;
    border: 1px solid #c89b3c;
    overflow: hidden;
    min-height: 319px; 
    aspect-ratio: 392 / 267;
    min-width: 0;
     width: 100%;
}

.ability-video video {
    width: 100%;
    height: 100%;
    display: block;
}

.ability-info .text {
    padding-left: 0;   /* Убираем левый отступ у текста описания */
    text-indent: 0;    /* Убираем красную строку */
}

.ability-info {
    flex: 1;
    max-width: 600px;
    transform: translateX(100px);
    color: white;
    text-align: left;
}

.ability-info h3 {
    margin-top: 0;
