.cons-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 30px 35px;
    transition: all 0.4s ease;
    backdrop-filter: blur(8px);
}

.pros-card:hover {
    transform: translateY(-4px);
    border-color: rgba(74, 200, 120, 0.4);
    box-shadow: 0 8px 40px rgba(74, 200, 120, 0.1);
    background: rgba(255, 255, 255, 0.05);
}

.cons-card:hover {
    transform: translateY(-4px);
    border-color: rgba(200, 74, 74, 0.4);
    box-shadow: 0 8px 40px rgba(200, 74, 74, 0.1);
    background: rgba(255, 255, 255, 0.05);
}

/* ===== ЗАГОЛОВКИ ===== */
.pros-header,
.cons-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 15px;
}

.pros-header h3,
.cons-header h3 {
    font-family: 'Beaufort for LOL', serif;
    font-size: 28px;
    margin: 0;
    letter-spacing: 2px;
}

.pros-header h3 {
    color: #4ac8a0;
}

.cons-header h3 {
    color: #c84a4a;
}

.pros-icon,
.cons-icon {
    font-size: 28px;
}

/* ===== СПИСКИ ===== */
.pros-list,
.cons-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.pros-list li,
.cons-list li {
    padding: 10px 0;
    padding-left: 25px;
    position: relative;
    color: #c8d0e0;
    font-size: 15px;
    line-height: 1.6;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    transition: color 0.3s ease;
}

.pros-list li:last-child,
.cons-list li:last-child {
    border-bottom: none;
}

/* ===== ИКОНКИ В СПИСКАХ ===== */
.pros-list li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: #4ac8a0;
    font-weight: bold;
    font-size: 18px;
}

.cons-list li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: #c84a4a;
    font-weight: bold;
    font-size: 18px;
}

/* ===== ПРИ НАВЕДЕНИИ НА ПУНКТ ===== */
.pros-list li:hover {
    color: #4ac8a0;
}

.cons-list li:hover {
    color: #c84a4a;
}

/* ===== АДАПТИВ ===== */
@media (max-width: 768px) {
    .pros-cons {
        padding: 40px 20px;
    }

    .pros-cons h2 {
        font-size: 40px;
    }

    .pros-cons-grid {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .pros-card,
    .cons-card {
        padding: 25px;
    }
}

