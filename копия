/* ===== СЕКЦИЯ СОВЕТОВ ===== */
.tips {
    bottom: 1px;
    
    padding: 60px 40px;
    /*background: linear-gradient(180deg, #0a0615, #0d0a1a);*/
    background: url(/static/images/background/forest.jpg) center/cover no-repeat;
    position: relative;
    z-index: 2;

}

.blue-divider {
    width: 100%;
    background-color: transparent;    
    padding: 0px 0;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    margin: 0;
    z-index: 10;
    margin-top: -1px;
}

.blue-divider .blue-line {
    width:80%;
    height: 1px;
    background: linear-gradient(90deg, 
        transparent,
        #4a8fc4 20%,
        #e0e6f0 50%,
        #4a8fc4 80%,
        transparent);
}

.blue-divider::before{
    content: "";
    position: absolute;
    width: 8px;
    left: 5%;
    height: 8px;
    border: 1px solid #4a8fc4;
    transform: rotate(45deg);
    background-color: transparent;
}

.blue-divider::after {
    content: "";
    position: absolute;
    height: 8px;
    width: 8px;
    right: 5%;
    border: 1px solid #4a8fc4;
    background-color: transparent;
    transform: rotate(45deg);
}

.tips h2 {
    text-align: center;
    font-size: 60px;
    background: linear-gradient(180deg, #4a8fc4, #e0e6f0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;  
    font-family: 'Beaufort for LOL', serif;
    margin-bottom: 40px;
    text-shadow: 0 0 40px rgba(74, 143, 196, 0.2);
    letter-spacing: 4px;
}

/* ===== СЕТКА КАРТОЧЕК ===== */
.tips-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
}

/* ===== КАРТОЧКА ===== */


.tip-card {
    background: rgba(255, 255, 255, 0.03);
    
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 20px 20px 20px 25px;
    position: relative;
    transition: all 0.4s ease;
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    gap: 15px;
}

/* ===== ЛЕВАЯ СВЕТЯЩАЯСЯ ПОЛОСА ===== */
.tip-glow {
    width: 3px;
    min-height: 40px;
    height: 100%;
    background: linear-gradient(180deg, #0a0a0f,  
        #4a8fc4,  
        #e0e6f0);
    border-radius: 2px;
    flex-shrink: 0;
    transition: all 0.4s ease;
}

/* ===== ТЕКСТ В КАРТОЧКЕ ===== */
.tip-card .text {
    margin: 0;
    padding: 0;
    text-indent: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #c8d0e0;
    flex: 1;
}

/* ===== ПРИ НАВЕДЕНИИ ===== */
.tip-card:hover {
    transform: translateY(-4px);
    border-color: rgba(74, 143, 196, 0.3);
    box-shadow: 0 8px 40px rgba(74, 143, 196, 0.1);
    background: rgba(255, 255, 255, 0.05);
}

.tip-card:hover .tip-glow {
    box-shadow: 0 0 25px rgba(74, 143, 196, 0.3);
    width: 4px;
}

.tip-card:hover .text {
    color: #e8eef5;
}

/* ===== АДАПТИВ ===== */
@media (max-width: 768px) {
    .tips-grid {
        grid-template-columns: 1fr;
    }
    
    .tips {
        padding: 40px 20px;
    }
    
    .tips h2 {
        font-size: 40px;
    }
}

